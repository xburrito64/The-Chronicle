node_modules/
dist/

# Your vault path lives here. Kept out of git so the repo can be public
# without naming a folder on your PC. Copy config.example.json to
# config.json after cloning. If you keep the repo private and would rather
# clone-and-run, delete the next line.
config.json

# Birthdays are people's: they stay on the machine they were typed into.
birthdays.json
birthdays.previous.json

# tooling scratch
.playwright-mcp/
*.log
release/

# Ideas and sketches: kept on this machine, not part of the app.
Idea/

# Icons for tags that are only this machine's own. The pictures stay here and
# in the installed app's settings folder; the repo's starter tags don't use
# them.
tag-icons/**/[Ss]moke*
tag-icons/**/[Dd][Gg][Gg]*
tag-icons/**/[Vv]ibe-[Cc]oding*
tag-icons/**/[Ww]alk-[Cc]oco*

# An overview sheet of every icon, personal ones included: not an icon itself.
tag-icons/**/all.png
